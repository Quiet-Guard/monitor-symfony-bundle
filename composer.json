{
    "name": "laboiteacode/monitor-symfony-bundle",
    "description": "Symfony bundle to report exceptions and application logs to a Quiet Guard server.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "monitoring",
        "error-tracking",
        "logging"
    ],
    "authors": [
        {
            "name": "Alexandre Ribes",
            "email": "alexandre@laboiteacode.fr",
            "homepage": "https://laboiteacode.fr"
        }
    ],
    "homepage": "https://github.com/Quiet-Guard/monitor-symfony-bundle",
    "support": {
        "issues": "https://github.com/Quiet-Guard/monitor-symfony-bundle/issues",
        "source": "https://github.com/Quiet-Guard/monitor-symfony-bundle"
    },
    "require": {
        "php": "^8.2",
        "laboiteacode/monitor-php": "^0.1",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "monolog/monolog": "^3.0"
    },
    "suggest": {
        "monolog/monolog": "Required (^3.0) to forward application logs through the monitor.log_handler service."
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\Monitor\\Symfony\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../monitor-php",
            "options": {
                "versions": {
                    "laboiteacode/monitor-php": "0.1.0"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
