{
    "name": "laboiteacode/monitor-symfony-bundle",
    "description": "Symfony bundle to report exceptions, logs and dependencies to a LaravelMonitor server.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laboiteacode/monitor-php": "^0.1",
        "symfony/config": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0"
    },
    "require-dev": {
        "monolog/monolog": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\Monitor\\Symfony\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
